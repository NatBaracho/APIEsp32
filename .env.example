# Modelo de configuração do Worker Oxide ⇄ FluxID.
# Copie para .env (o .env fica fora do git) e preencha.
# Nunca registre a senha real neste arquivo nem em documentos.

# Conexão com o banco FluxID (PostgreSQL), no formato:
# postgres://USUARIO:SENHA@HOST:PORTA/FluxID_db
FLUXID_DATABASE_URL=

# Intervalo entre rodadas do Worker, em segundos
WORKER_INTERVAL_SECONDS=10

# Intervalo para trazer o cadastro do FluxID (dispositivos, lacres,
# cilindros, vínculos e hash das chaves), em segundos
WORKER_CADASTRO_INTERVAL_SECONDS=300

# Máximo de linhas de cada fila enviadas por rodada
WORKER_BATCH_SIZE=100

# --- API do frontend (/api/v1/app) ---
# A API usa a mesma FLUXID_DATABASE_URL acima.
# Origens do frontend autorizadas no navegador (CORS), separadas por vírgula.
# Vazio = só as de desenvolvimento (localhost:5173, :4173, :3001)
APP_ORIGENS=
# Pasta das fotos das pessoas (profile-avatar)
APP_PASTA_ARQUIVOS=arquivos
# Só em teste: 1 devolve os tokens de convite e de recuperação de senha na
# resposta (não há envio de e-mail ainda). Nunca use 1 em produção
APP_EXPOR_TOKENS=

# --- Regras automáticas de alerta (padrões entre parênteses) ---
REGRA_BATERIA_MINIMA=15
REGRA_GSM_MINIMO_DBM=-105
REGRA_SEM_COMUNICACAO_MINUTOS=30
REGRA_GPS_SEM_SINAL_MINUTOS=15
REGRA_COMANDO_SEM_RESPOSTA_MINUTOS=10
# Depois de um alerta automático, quanto tempo esperar antes de abrir outro
# do mesmo tipo para o mesmo dispositivo
REGRA_REPETICAO_MINUTOS=30
# Margem padrão da rota (metros), quando a rota não informa
REGRA_MARGEM_ROTA_METROS=50

# --- Manutenção ---
BACKUP_PASTA=backups
BACKUP_MANTER=14
RETENCAO_DIAS=30
