# Modelo de configuração do Worker Oxide ⇄ FluxID.
# Copie para .env (o .env fica fora do git) e preencha.
# Nunca registre a senha real neste arquivo nem em documentos.

# Conexão com o banco FluxID (PostgreSQL), no formato:
# postgres://USUARIO:SENHA@HOST:PORTA/FluxID_db
FLUXID_DATABASE_URL=

# Intervalo entre rodadas do Worker, em segundos
WORKER_INTERVAL_SECONDS=10

# Intervalo para trazer o cadastro do FluxID (dispositivos, lacres,
# cilindros, vínculos e hash das chaves), em segundos
WORKER_CADASTRO_INTERVAL_SECONDS=300

# Máximo de linhas de cada fila enviadas por rodada
WORKER_BATCH_SIZE=100
