# Modelo de configuração. Copie para .env (o .env fica fora do git) e preencha.
# Nunca registre a chave real neste arquivo, em documentos ou em conversas.

# --- API ---
# Porta em que a API atende. Sem esta linha, vale a 3000
# PORT=3000

# --- Banco principal (Supabase) ---
# Endereço da função de recebimento, no formato:
# https://<projeto>.supabase.co/functions/v1/<nome-da-funcao>
SUPABASE_IOT_URL=
# Chave service_role do projeto Supabase
SUPABASE_SERVICE_KEY=

# --- Worker ---
# Intervalo entre rodadas, em segundos
WORKER_INTERVAL_SECONDS=10
# Intervalo para trazer o cadastro de dispositivos (com o hash das chaves), em segundos
WORKER_CADASTRO_INTERVAL_SECONDS=300
# Máximo de mensagens enviadas por lote (até 10 lotes por rodada). Com 100, o
# Worker envia cerca de 96 mensagens por segundo; com 500, cerca de 400. Aumente
# se a fila demorar a esvaziar depois de uma queda do banco principal
WORKER_BATCH_SIZE=100

# --- Alertas automáticos (saem da própria mensagem do lacre) ---
REGRA_BATERIA_MINIMA=15
REGRA_SINAL_MINIMO_DBM=-105
# Minutos que o sistema tem para vincular o cilindro depois que o lacre avisa
# que está ativo. Passado esse tempo, lacre enviando sem cilindro abre alerta
REGRA_MINUTOS_SEM_VINCULO=10

# --- Manutenção ---
BACKUP_PASTA=backups
BACKUP_MANTER=14
RETENCAO_DIAS=30
