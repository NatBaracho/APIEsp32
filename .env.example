# Modelo de configuração. Copie para .env (o .env fica fora do git) e preencha.
# Nunca registre a chave real neste arquivo, em documentos ou em conversas.

# --- API ---
# Porta em que a API atende. Sem esta linha, vale a 3000
# PORT=3000

# Chave de administrador, para as rotas da equipe (dispositivos, mensagens,
# fila e métricas). Pelo menos 16 caracteres. Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Sem ela, as rotas da equipe ficam fechadas (503)
ADMIN_API_KEY=
# true abre as rotas da equipe sem chave. Só para teste de bancada
# ROTAS_DA_EQUIPE_ABERTAS=false

# Limites por minuto: mensagens de cada lacre e chaves erradas de cada endereço
LIMITE_MENSAGENS_POR_MINUTO=120
LIMITE_FALHAS_DE_CHAVE_POR_MINUTO=60

# HTTPS direto na API: caminho do certificado e da chave dele. Sem os dois, a API atende em HTTP
# HTTPS_CERT_FILE=
# HTTPS_KEY_FILE=
# true quando há um proxy (nginx, Caddy) na frente da API
# PROXY_CONFIAVEL=false

# true (padrão): a API só confirma a mensagem depois de gravada no disco.
# false: mais rápida, mas um corte de energia pode levar as mensagens do último instante
# GRAVACAO_GARANTIDA=true

# --- Banco principal (Supabase) ---
# Endereço da função de recebimento, no formato:
# https://<projeto>.supabase.co/functions/v1/<nome-da-funcao>
SUPABASE_IOT_URL=
# Chave service_role do projeto Supabase
SUPABASE_SERVICE_KEY=

# --- Worker ---
# Intervalo entre rodadas, em segundos
WORKER_INTERVAL_SECONDS=10
# Intervalo para trazer o cadastro de dispositivos (com o hash das chaves), em segundos
WORKER_CADASTRO_INTERVAL_SECONDS=300
# Máximo de mensagens enviadas por lote (até 10 lotes por rodada). Quando há
# fila acumulada, o Worker não espera entre as rodadas
WORKER_BATCH_SIZE=100

# --- Alertas automáticos (saem da própria mensagem do lacre) ---
REGRA_BATERIA_MINIMA=15
REGRA_SINAL_MINIMO_DBM=-105
# Minutos que o sistema tem para vincular o cilindro depois que o lacre avisa
# que está ativo. Passado esse tempo, lacre enviando sem cilindro abre alerta
REGRA_MINUTOS_SEM_VINCULO=10

# --- Manutenção ---
BACKUP_PASTA=backups
BACKUP_MANTER=14
RETENCAO_DIAS=30
# Hora do backup diário feito pelo npm run servico
BACKUP_HORA=03:00

# --- Vigia (npm run vigia) ---
# Endereço que recebe os avisos (POST com JSON). Vazio: só tela e arquivo
VIGIA_WEBHOOK_URL=
# A partir de quanto o vigia avisa
VIGIA_FILA_MAXIMA=5000
VIGIA_ESPERA_MAXIMA_MIN=30
VIGIA_WORKER_PARADO_MIN=5
VIGIA_BANCO_MAXIMO_MB=1024
